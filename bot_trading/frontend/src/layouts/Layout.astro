---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="XAUUSD Autonomous Trading Terminal" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-background text-on-surface h-screen flex flex-col overflow-hidden select-none font-sans">
		<slot />
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;

	body {
		font-family: 'Geist', sans-serif;
	}
	.data-font {
		font-family: 'JetBrains Mono', monospace;
	}
	
	/* Custom scrollbar */
	::-webkit-scrollbar { width: 6px; height: 6px; }
	::-webkit-scrollbar-track { background: #12131a; }
	::-webkit-scrollbar-thumb { background: #33343c; border-radius: 3px; }
	::-webkit-scrollbar-thumb:hover { background: #3c4a42; }

	.term-panel { border: 1px solid #3c4a42; background: #1e1f26; }
	.term-border { border-color: #3c4a42; }
	.text-profit { color: #10B981; }
	.text-loss { color: #EF4444; }
	.bg-profit { background-color: rgba(16, 185, 129, 0.1); }
	.bg-loss { background-color: rgba(239, 68, 68, 0.1); }
	.border-profit { border-color: #10B981; }
	.border-loss { border-color: #EF4444; }
	
	.pulse-live { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: .5; }
	}
	
	.glow-green {
		box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
	}

	.chart-grid {
		background-size: 40px 40px;
		background-image:
			linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
	}

	/* Ocultar marcas de agua y branding */
	.tradingview-widget-copyright {
		display: none !important;
	}
</style>
