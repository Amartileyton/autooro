# ==============================================================================
# CONFIGURACIÓN DEL MOTOR DE TRADING AUTÓNOMO XAUUSD (TELEGRAM -> BROKER)
# ==============================================================================

# Entorno y API
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_KEY=sec_xauusd_trading_key_2026
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db

# Ingesta Telegram MTProto (Telethon)
# Obtén estos datos en: https://my.telegram.org -> API development tools
TG_API_ID=12345678
TG_API_HASH=abcdef0123456789abcdef0123456789
TG_PHONE=+34600000000
TG_SESSION_NAME=bot_session
# ID del canal VIP de donde se leen las señales (ej. -1001234567890)
TARGET_CHANNEL_ID=-1001234567890
INGESTION_ENABLED=true

# Bot Administrativo Privado de Telegram (Aiogram)
# Token obtenido de @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Tu ID personal de usuario en Telegram (obtenido de @userinfobot)
ADMIN_TELEGRAM_USER_ID=987654321

# Motor de Riesgo y Slots
MAX_CONCURRENT_SLOTS=4
SLOT_MARGIN_PERCENT=0.25
LEVERAGE=100.0
CONTRACT_SIZE=100.0
MIN_LOT_SIZE=0.01
LOT_STEP=0.01
SLIPPAGE_TOLERANCE_USD=0.00
DEFAULT_DYNAMIC_SL_DELTA_USD=8.50
AUTO_EXECUTION_ENABLED=true

# Capa de Broker: 'paper' para simulación local, 'ctrader' para cuenta real
BROKER_TYPE=paper
INITIAL_PAPER_BALANCE=10000.00
PAPER_SPREAD_MIN_CENTS=0.10
PAPER_SPREAD_MAX_CENTS=0.25
INITIAL_XAUUSD_PRICE=2345.50

# cTrader Open API (Requerido solo si BROKER_TYPE=ctrader)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=
CTRADER_ACCESS_TOKEN=
CTRADER_HOST=live.ctraderapi.com
CTRADER_PORT=5035

# IA Fallback (Opcional para rescate de señales no estructuradas)
AI_FALLBACK_ENABLED=false
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
